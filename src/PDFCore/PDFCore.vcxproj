    <ClCompile Include="convert\ZipWriter.cpp" />
    <ClCompile Include="Forms.cpp" />
    <ClCompile Include="BitmapCache.cpp" />
    <ClCompile Include="Document.cpp" />
    <ClCompile Include="DocumentStore.cpp" />
    <ClCompile Include="Engine.cpp" />
    <ClCompile Include="PageLayout.cpp" />
    <ClCompile Include="PageOps.cpp" />
    <ClCompile Include="PageRange.cpp" />
    <ClCompile Include="FileIO.cpp" />
    <ClCompile Include="ImageExport.cpp" />
    <ClCompile Include="PageGeometry.cpp" />
