<?xml version="1.0" encoding="utf-8"?>
<!--
  PDFCore: PDF engine wrapper (PDFium + qpdf). Static library, no UI, no
  FluentUI headers, so tests can link it headless. Shared compiler settings
  come from ../../Directory.Build.props.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{4d7c2a1e-5b3f-4e8a-9c61-0f2d8b7a3e10}</ProjectGuid>
    <RootNamespace>PDFCore</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(PDFToolRoot)build\PDFCore.Consumer.props" />
  <ItemGroup>
    <ClInclude Include="Annotations.h" />
    <ClInclude Include="CommandLine.h" />
    <ClInclude Include="RecentFiles.h" />
    <ClInclude Include="convert\Analyze.h" />
    <ClInclude Include="convert\Convert.h" />
    <ClInclude Include="convert\DocxWriter.h" />
    <ClInclude Include="convert\Extract.h" />
    <ClInclude Include="convert\Model.h" />
    <ClInclude Include="convert\ZipWriter.h" />
    <ClInclude Include="Forms.h" />
    <ClInclude Include="BitmapCache.h" />
    <ClInclude Include="Document.h" />
    <ClInclude Include="DocumentStore.h" />
    <ClInclude Include="Engine.h" />
    <ClInclude Include="PageLayout.h" />
    <ClInclude Include="PageOps.h" />
    <ClInclude Include="PageRange.h" />
    <ClInclude Include="FileIO.h" />
    <ClInclude Include="ImageExport.h" />
    <ClInclude Include="PageGeometry.h" />
    <ClInclude Include="QpdfOps.h" />
    <ClInclude Include="Render.h" />
    <ClInclude Include="TextSearch.h" />
    <ClInclude Include="Result.h" />
    <ClInclude Include="Trace.h" />
    <ClInclude Include="UnitMapping.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Annotations.cpp" />
    <ClCompile Include="RecentFiles.cpp" />
